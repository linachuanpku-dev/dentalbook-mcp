# Optional path to built MCP App HTML resources.
DENTALBOOK_UI_DIR=/absolute/path/to/dentalbookv5/apps/mcp-ui/dist

# Admin MCP. HTTP is the default transport; stdio is for local Cursor/Codex builders.
DENTALBOOK_ADMIN_HOST=127.0.0.1
DENTALBOOK_ADMIN_PORT=7341
DENTALBOOK_ADMIN_TOKEN=
DENTALBOOK_ADMIN_CENTER_URL=https://127.0.0.1:17342
DENTALBOOK_ADMIN_CENTER_BEARER=
# DENTALBOOK_ADMIN_MCP_TRANSPORT=stdio

# User MCP reads this JSON. Keep the real file under ignored .dentalbook-local/.
DENTALBOOK_USER_CONFIG=/absolute/path/to/dentalbookv5/.dentalbook-local/user.json
# user.json also requires an absolute importRoots array, for example the current user's Downloads directory.

# Optional Streamable HTTP transport for the same user MCP. Defaults to stdio.
# DENTALBOOK_USER_MCP_TRANSPORT=http
# DENTALBOOK_USER_MCP_HOST=127.0.0.1
# DENTALBOOK_USER_MCP_PORT=7340

# Linux center service. Never commit the users file, TLS key, or database.
DENTALBOOK_CENTER_ROOT=/var/lib/dentalbook-test-library
DENTALBOOK_CENTER_HOST=127.0.0.1
DENTALBOOK_CENTER_PORT=7342
DENTALBOOK_CENTER_USERS_FILE=/var/lib/dentalbook-test-library/secrets/users.json
DENTALBOOK_CENTER_TLS_CERT=/var/lib/dentalbook-test-library/secrets/tls/server.crt
DENTALBOOK_CENTER_TLS_KEY=/var/lib/dentalbook-test-library/secrets/tls/server.key
# For Cloudflare Tunnel on the same Linux host, TLS may terminate at Cloudflare
# and the origin may use loopback HTTP only when this explicit switch is set.
DENTALBOOK_CENTER_ALLOW_INSECURE_LOOPBACK=0

# Built standalone light-theme Web UI served by center-service.
DENTALBOOK_WEB_DIR=/opt/dentalbookv5/apps/web/dist
