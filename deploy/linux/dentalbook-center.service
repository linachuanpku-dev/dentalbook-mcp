[Unit]
Description=Dentalbook shared literature center and Web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dentalbook
Group=dentalbook
WorkingDirectory=/opt/dentalbookv5
EnvironmentFile=/etc/dentalbook/center.env
ExecStart=/usr/bin/node /opt/dentalbookv5/packages/center-service/dist/index.js
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dentalbook-test-library

[Install]
WantedBy=multi-user.target
