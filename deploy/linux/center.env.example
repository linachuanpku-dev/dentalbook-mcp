DENTALBOOK_CENTER_ROOT=/var/lib/dentalbook-test-library
DENTALBOOK_CENTER_HOST=127.0.0.1
DENTALBOOK_CENTER_PORT=7342
DENTALBOOK_CENTER_USERS_FILE=/var/lib/dentalbook-test-library/secrets/users.json
DENTALBOOK_WEB_DIR=/opt/dentalbookv5/apps/web/dist
DENTALBOOK_RELEASES_DIR=/opt/dentalbookv5/releases/mcp-user

# Cloudflare Tunnel runs on the same Linux host and connects to loopback HTTP.
DENTALBOOK_CENTER_ALLOW_INSECURE_LOOPBACK=1
